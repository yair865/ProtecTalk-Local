<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/introFragment">

    <fragment
        android:id="@+id/introFragment"
        android:name="com.example.protectalk.ui.IntroFragment"
        android:label="Intro">
        <action
            android:id="@+id/action_intro_to_signUp"
            app:destination="@id/signUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.protectalk.ui.SignUpFragment"
        android:label="Sign Up">
        <action
            android:id="@+id/action_signUp_to_home"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.protectalk.ui.HomeFragment"
        android:label="Home" />
</navigation>
